{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Content-Security-Policy", "value": "base-uri 'self'; object-src 'none'; frame-ancestors 'self'" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(), payment=()" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "redirects": [
    { "source": "/meowguard", "destination": "/MeoWGuard/", "permanent": true },
    { "source": "/meowguard/", "destination": "/MeoWGuard/", "permanent": true },

    { "source": "/hdmi-tool", "destination": "/ps5-hdmi-tool/", "permanent": false },
    { "source": "/hdmi", "destination": "/ps5-hdmi-tool/", "permanent": false },
    { "source": "/iron-check", "destination": "/Iron-Check/", "permanent": false },
    { "source": "/ironcheck", "destination": "/Iron-Check/", "permanent": false },
    { "source": "/control-ps5", "destination": "/Control-PS-5/", "permanent": false },
    { "source": "/control-ps-5", "destination": "/Control-PS-5/", "permanent": false },
    { "source": "/bancadasync", "destination": "/BancadaSync-Download/", "permanent": false },
    { "source": "/bancada", "destination": "/BancadaSync-Download/", "permanent": false },
    { "source": "/controle-test", "destination": "/ps5-controle-test/", "permanent": false },
    { "source": "/controle", "destination": "/ps5-controle-test/", "permanent": false },

    { "source": "/guia", "destination": "https://guia-switch-tech-meow.vercel.app/", "permanent": false },
    { "source": "/jnx", "destination": "https://github.com/MeoWDev-MOD/JNX", "permanent": false },
    { "source": "/curso", "destination": "https://pay.kiwify.com.br/leiZv0k", "permanent": false },

    { "source": "/desbloqueio", "destination": "/#desbloqueio", "permanent": false },
    { "source": "/reparos", "destination": "/#reparos", "permanent": false },
    { "source": "/loja", "destination": "/#loja", "permanent": false },
    { "source": "/contato", "destination": "/#contato", "permanent": false },

    { "source": "/:caminho((?!api/|\\.well-known/)(?:[^/]+/)*(?!LICENSE$)[^/.]+)", "destination": "/:caminho/", "permanent": true }
  ]
}
